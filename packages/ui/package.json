{
  "name": "@saurlax/saui",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.81.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17",
    "tailwindcss": "^4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "4.23.1",
    "tw-animate-css": "^1.4.0",
    "@fontsource-variable/geist": "^5.3.0",
    "vite": "^8"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saurlax/saui.git",
    "directory": "packages/ui"
  }
}
