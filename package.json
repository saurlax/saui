{
  "name": "saui",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "pnpm dev:preview",
    "dev:preview": "pnpm --filter @saurlax/saui build && pnpm --filter @saurlax/saui-preview dev",
    "storybook": "pnpm --filter @saurlax/saui-preview storybook",
    "build-storybook": "pnpm --filter @saurlax/saui-preview build-storybook",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "ui:add": "pnpm --filter @saurlax/saui exec shadcn add --cwd ../../apps/web"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.11",
    "typescript": "~6.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
